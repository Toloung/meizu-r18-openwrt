 TARGET_DEVICES += asus_rt-ac1200-v2
 
+define Device/meizu_r18
+  IMAGE_SIZE := 15360k
+  DEVICE_VENDOR := Meizu
+  DEVICE_MODEL := R18
+  DEVICE_VARIANT := Stage 4 Release Candidate 2
+  DEVICE_PACKAGES := kmod-mt76 kmod-mt7603 kmod-mt76x2 kmod-usb2 kmod-usb-ohci
+  SUPPORTED_DEVICES += meizu,r18
+  # Recovery is the only full-firmware artifact and intentionally has no
+  # metadata. Sysupgrade remains compact, but carries normal OpenWrt metadata
+  # so MT76x8 can verify meizu,r18 before writing only the firmware partition.
+  IMAGES += recovery.bin
+  IMAGE/recovery.bin := append-kernel | append-rootfs | pad-rootfs | r18-pad-to-ff $$(IMAGE_SIZE) | check-size
+  IMAGE/sysupgrade.bin := append-kernel | append-rootfs | pad-rootfs | check-size | append-metadata
+endef
+TARGET_DEVICES += meizu_r18
+
+# pad-to uses dd conv=sync, which pads with zero bytes.  The R18 TFTP image
+# must instead erase the firmware tail logically: retain its JFFS2 marker and
+# append only 0xff up to the exact 0xf00000-byte firmware partition boundary.
+define Build/r18-pad-to-ff
+	@imagesize="$$(stat -c%s $@)"; \
+	limitsize="$$(($(call exp_units,$(1))))"; \
+	[ "$$imagesize" -le "$$limitsize" ] || { \
+		echo "R18 recovery image is too large: $$imagesize > $$limitsize" >&2; \
+		exit 1; \
+	}; \
+	padsize="$$((limitsize - imagesize))"; \
+	if [ "$$padsize" -gt 0 ]; then \
+		LC_ALL=C dd if=/dev/zero bs="$$padsize" count=1 2>/dev/null | \
+			LC_ALL=C tr '\000' '\377' >> $@; \
+	fi; \
+	[ "$$(stat -c%s $@)" -eq "$$limitsize" ] || { \
+		echo "R18 recovery padding produced an incorrect size" >&2; \
+		exit 1; \
+	}
+endef
+
