index 0000000..c0ffee0
--- /dev/null
+++ b/target/linux/ramips/mt76x8/base-files/etc/uci-defaults/99-r18-wifi-defaults
@@ -0,0 +1,64 @@
+#!/bin/sh
+# First boot only. CI supplies the PSK in an image overlay; never store it in
+# the public board patch. The boot sequence runs wifi config before this.
+
+psk_file=/etc/r18-wifi-psk
+[ -r "$psk_file" ] || {
+	logger -t r18-wifi-defaults 'No private PSK supplied; leaving Wi-Fi disabled.'
+	exit 0
+}
+
+psk="$(cat "$psk_file")"
+rm -f "$psk_file"
+
+[ "${#psk}" -ge 8 ] || {
+	logger -t r18-wifi-defaults 'Invalid private PSK; leaving Wi-Fi disabled.'
+	exit 0
+}
+
+# wifi config may create a generic default iface for each PHY. Replace all of
+# those first-boot placeholders with the two R18 LAN APs.
+for iface in $(uci show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
+	uci -q delete "wireless.$iface"
+done
+
+uci -q delete wireless.r18_24g
+uci -q delete wireless.r18_5g
+
+configure_ap() {
+	section="$1"
+	radio="$2"
+	ssid="$3"
+
+	uci set "wireless.$radio.disabled=0"
+	uci set "wireless.$section=wifi-iface"
+	uci set "wireless.$section.device=$radio"
+	uci set "wireless.$section.mode=ap"
+	uci set "wireless.$section.network=lan"
+	uci set "wireless.$section.ssid=$ssid"
+	# WPA2-PSK/CCMP is supported by the selected compact wpad package. A later
+	# LuCI change may select WPA3 where the installed AP package supports it.
+	uci set "wireless.$section.encryption=psk2+ccmp"
+	uci set "wireless.$section.key=$psk"
+}
+
+have_24g=0
+have_5g=0
+for radio in $(uci show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
+	case "$(uci -q get "wireless.$radio.band")" in
+		2g)
+			configure_ap r18_24g "$radio" 'R18-OpenWrt'
+			have_24g=1
+			;;
+		5g)
+			configure_ap r18_5g "$radio" 'R18-OpenWrt-5G'
+			have_5g=1
+			;;
+	esac
+done
+
+[ "$have_24g" = 1 ] || logger -t r18-wifi-defaults 'No 2.4 GHz radio was generated.'
+[ "$have_5g" = 1 ] || logger -t r18-wifi-defaults 'No 5 GHz radio was generated.'
+
+uci commit wireless
+exit 0
diff --git a/target/linux/ramips/mt76x8/base-files/etc/init.d/r18-net-rescue b/target/linux/ramips/mt76x8/base-files/etc/init.d/r18-net-rescue
