+#!/bin/sh
+# Target base-files post-installation enables init scripts. Disable this
+# board-specific recovery service during first boot, before its S99 phase.
+# The service remains available for a deliberate manual start or enable.
+
+if [ -x /etc/init.d/r18-net-rescue ]; then
+	/etc/init.d/r18-net-rescue disable
+fi
+
+exit 0
