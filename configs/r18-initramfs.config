# Meizu R18 Stage 2: RAM-only diagnostic image.  This configuration does not
# authorise, produce, or invoke a flash-write workflow.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_meizu_r18=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y

# Remote access and diagnostic userspace.
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_usbutils=y

# Board-specific device support; dependencies select the required PCI support.
CONFIG_PACKAGE_kmod-mt76x2=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
