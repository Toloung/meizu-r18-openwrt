diff --git a/target/linux/ramips/image/mt76x8.mk b/target/linux/ramips/image/mt76x8.mk
index 96b3aeb..2768399 100644
--- a/target/linux/ramips/image/mt76x8.mk
+++ b/target/linux/ramips/image/mt76x8.mk
@@ -104,6 +104,42 @@ define Device/asus_rt-ac1200-v2
 endef
 TARGET_DEVICES += asus_rt-ac1200-v2
 
+define Device/meizu_r18
+  IMAGE_SIZE := 15360k
+  DEVICE_VENDOR := Meizu
+  DEVICE_MODEL := R18
+  DEVICE_VARIANT := Stage 2.4 Fix S25FL128S1 256-byte page programming
+  DEVICE_PACKAGES := kmod-mt7603 kmod-mt76x2 kmod-usb2 kmod-usb-ohci
+  SUPPORTED_DEVICES += meizu,r18
+  # Recovery is the only full-firmware artifact.  It intentionally has no
+  # sysupgrade metadata and must not be used without hardware validation.
+  IMAGES += recovery.bin
+  IMAGE/recovery.bin := append-kernel | append-rootfs | pad-rootfs | r18-pad-to-ff $$(IMAGE_SIZE) | check-size
+  IMAGE/sysupgrade.bin := append-kernel | append-rootfs | pad-rootfs | check-size
+endef
+TARGET_DEVICES += meizu_r18
+
+# pad-to uses dd conv=sync, which pads with zero bytes.  The R18 TFTP image
+# must instead erase the firmware tail logically: retain its JFFS2 marker and
+# append only 0xff up to the exact 0xf00000-byte firmware partition boundary.
+define Build/r18-pad-to-ff
+	@imagesize="$$(stat -c%s $@)"; \
+	limitsize="$$(($(call exp_units,$(1))))"; \
+	[ "$$imagesize" -le "$$limitsize" ] || { \
+		echo "R18 recovery image is too large: $$imagesize > $$limitsize" >&2; \
+		exit 1; \
+	}; \
+	padsize="$$((limitsize - imagesize))"; \
+	if [ "$$padsize" -gt 0 ]; then \
+		LC_ALL=C dd if=/dev/zero bs="$$padsize" count=1 2>/dev/null | \
+			LC_ALL=C tr '\000' '\377' >> $@; \
+	fi; \
+	[ "$$(stat -c%s $@)" -eq "$$limitsize" ] || { \
+		echo "R18 recovery padding produced an incorrect size" >&2; \
+		exit 1; \
+	}
+endef
+
 define Device/asus_rt-n10p-v3
   IMAGE_SIZE := 7872k
   DEVICE_VENDOR := ASUS
