diff --git a/target/linux/ramips/mt76x8/base-files/usr/sbin/r18-healthcheck b/target/linux/ramips/mt76x8/base-files/usr/sbin/r18-healthcheck
new file mode 100755
index 0000000..c0ffee7
--- /dev/null
+++ b/target/linux/ramips/mt76x8/base-files/usr/sbin/r18-healthcheck
@@ -0,0 +1,230 @@
+#!/bin/sh
+# Read-only Meizu R18 diagnostics. It intentionally does not alter services,
+# configuration, or persistent storage.
+
+failed=0
+warned=0
+params=/sys/kernel/debug/spi-nor/spi0.0/params
+
+pass() {
+	echo "[PASS] $*"
+}
+
+warn() {
+	echo "[WARN] $*"
+	warned=1
+}
+
+fail() {
+	echo "[FAIL] $*"
+	failed=1
+}
+
+param_value() {
+	# spi-nor debugfs values such as the JEDEC ID and size contain spaces.
+	# Remove only the requested field name(s), then return the complete value.
+	if [ -n "$2" ]; then
+		awk -v first="$1" -v second="$2" '
+			$1 == first && $2 == second {
+				sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]*/, "")
+				print
+				exit
+			}' "$params" 2>/dev/null
+	else
+		awk -v first="$1" '
+			$1 == first {
+				sub(/^[[:space:]]*[^[:space:]]+[[:space:]]*/, "")
+				print
+				exit
+			}' "$params" 2>/dev/null
+	fi
+}
+
+dmesg_count() {
+	count="$(dmesg 2>/dev/null | grep -c -- "$1" 2>/dev/null)"
+	[ -n "$count" ] || count=0
+	printf '%s' "$count"
+}
+
+expect_spi() {
+	label="$1"
+	expected="$2"
+	actual="$3"
+	echo "$label: ${actual:-unavailable}"
+	if [ "$actual" = "$expected" ]; then
+		pass "$label is $expected"
+	else
+		fail "$label expected $expected"
+	fi
+}
+
+# Used only by the CI parser regression test after sourcing this file. Normal
+# invocation deliberately continues into the read-only diagnostics below.
+if [ "${R18_HEALTHCHECK_TEST_ONLY:-0}" = 1 ]; then
+	return 0 2>/dev/null || exit 0
+fi
+
+echo '=================================================='
+echo 'Meizu R18 Health Check'
+echo '=================================================='
+
+echo
+echo 'SYSTEM'
+echo "Board: $(board_name 2>/dev/null || echo unavailable)"
+echo "OpenWrt: $(. /etc/openwrt_release 2>/dev/null; echo "${DISTRIB_RELEASE:-unavailable}")"
+echo "Kernel: $(uname -r 2>/dev/null || echo unavailable)"
+echo "Uptime: $(uptime 2>/dev/null || echo unavailable)"
+
+echo
+echo 'SPI NOR'
+if [ -r "$params" ]; then
+	spi_name="$(param_value name '')"
+	spi_jedec="$(param_value id '')"
+	spi_size="$(param_value size '')"
+	page_size="$(param_value page size)"
+	write_size="$(param_value write size)"
+else
+	spi_name=
+	spi_jedec=
+	spi_size=
+	page_size=
+	write_size=
+fi
+expect_spi 'Name' 's25fl128s1' "$spi_name"
+expect_spi 'JEDEC' '01 20 18 4d 01 80' "$spi_jedec"
+echo "Size: ${spi_size:-unavailable}"
+expect_spi 'Page size' '256' "$page_size"
+echo "Write size: ${write_size:-unavailable}"
+erase_size="$(cat /sys/class/mtd/mtd6/erasesize 2>/dev/null || true)"
+echo "Erase size: ${erase_size:-unavailable}"
+
+echo
+echo 'MTD LAYOUT'
+cat /proc/mtd 2>/dev/null || echo 'MTD layout: unavailable'
+for partition in bootloader config factory firmware storage; do
+	if grep -q "\"$partition\"" /proc/mtd 2>/dev/null; then
+		pass "MTD partition present: $partition"
+	else
+		warn "MTD partition unavailable: $partition"
+	fi
+done
+
+echo
+echo 'JFFS2'
+if grep -qs '^/dev/mtdblock6 /overlay jffs2 ' /proc/mounts 2>/dev/null; then
+	echo 'Overlay: /dev/mtdblock6 on /overlay (jffs2)'
+	pass 'overlay is mounted from mtd6 as jffs2'
+else
+	echo 'Overlay: unavailable'
+	fail 'overlay is not mounted from /dev/mtdblock6 as jffs2'
+fi
+rootfs_data_size="$(cat /sys/class/mtd/mtd6/size 2>/dev/null || true)"
+echo "rootfs_data size: ${rootfs_data_size:-unavailable}"
+magic="$(dmesg_count 'Magic bitmask')"
+crc="$(dmesg_count 'CRC failed')"
+wrong_data_crc="$(dmesg_count 'wrong data CRC')"
+truncating="$(dmesg_count 'Truncating ino')"
+echo "Magic bitmask: $magic"
+echo "CRC failed: $crc"
+echo "wrong data CRC: $wrong_data_crc"
+echo "Truncating inode: $truncating"
+for value in "$magic" "$crc" "$wrong_data_crc" "$truncating"; do
+	case "$value" in
+		0) ;;
+		*) fail 'JFFS2 error counter is non-zero or unreadable' ;;
+	esac
+done
+[ "$failed" -eq 0 ] && pass 'JFFS2 error counters are zero'
+
+echo
+echo 'NETWORK'
+if ip link show br-lan >/dev/null 2>&1; then
+	echo 'br-lan: UP'
+	pass 'br-lan exists'
+else
+	echo 'br-lan: unavailable'
+	warn 'br-lan is unavailable'
+fi
+lan_ip="$(ip -4 addr show dev br-lan 2>/dev/null | awk '/inet / { print $2; exit }')"
+echo "LAN IP: ${lan_ip:-unavailable}"
+[ "$lan_ip" = '192.168.1.1/24' ] && pass 'LAN IP is 192.168.1.1/24' || warn 'LAN IP is not 192.168.1.1/24'
+for device in eth0.1 eth0.2; do
+	if ip link show "$device" >/dev/null 2>&1; then
+		echo "$device: present"
+	else
+		echo "$device: unavailable"
+		warn "$device is unavailable"
+	fi
+done
+echo 'WAN VLAN: eth0.2'
+if ip link show br-lan 2>/dev/null | grep -q 'UP'; then
+	echo 'LAN bridge status: UP'
+else
+	echo 'LAN bridge status: unavailable'
+	warn 'LAN bridge is not UP'
+fi
+wan_status="$(ubus call network.interface.wan status 2>/dev/null)"
+case "$wan_status" in
+	*'"up": true'*) echo 'WAN status: UP'; pass 'WAN interface is up' ;;
+	*) echo 'WAN status: down or unavailable'; warn 'WAN interface is not up' ;;
+esac
+
+echo
+echo 'WIFI'
+radio_status() {
+	label="$1"
+	interface="$2"
+
+	if ip link show "$interface" >/dev/null 2>&1; then
+		echo "$label: present ($interface)"
+		ssid="$(iwinfo "$interface" info 2>/dev/null | sed -n 's/.*ESSID: "\(.*\)"/\1/p' | head -n 1)"
+		echo "$label SSID: ${ssid:-unavailable}"
+		status="$(ubus call "hostapd.$interface" get_status 2>/dev/null)"
+		case "$status" in
+			*'"status": "ENABLED"'*) echo "$label AP status: ENABLED"; pass "$label hostapd AP is enabled" ;;
+			*) echo "$label AP status: unavailable"; warn "$label hostapd AP status is unavailable" ;;
+		esac
+	else
+		echo "$label: unavailable ($interface)"
+		warn "$label AP is unavailable"
+	fi
+}
+
+radio_status 'radio0 / 2.4 GHz' phy0-ap0
+radio_status 'radio1 / 5 GHz' phy1-ap0
+
+echo
+echo 'RESCUE'
+rescue_auto=disabled
+for link in /etc/rc.d/S??r18-net-rescue; do
+	[ -L "$link" ] && rescue_auto=enabled
+done
+echo "r18-net-rescue enabled: $rescue_auto"
+[ "$rescue_auto" = disabled ] && pass 'Auto start: disabled' || warn 'Auto start: enabled'
+if ps w 2>/dev/null | grep -q '[r]18-net-rescue-worker'; then
+	echo 'r18-net-rescue running: yes'
+else
+	echo 'r18-net-rescue running: no'
+fi
+last_rescue="$(logread 2>/dev/null | grep 'r18-net-rescue' | tail -n 1)"
+echo "last rescue execution: ${last_rescue:-none}"
+if [ -x /etc/init.d/r18-net-rescue ]; then
+	echo 'Manual service available: yes'
+	pass 'manual rescue service is available'
+else
+	echo 'Manual service available: no'
+	fail 'manual rescue service is missing'
+fi
+
+echo
+echo 'RESULT'
+if [ "$failed" -ne 0 ]; then
+	echo 'FAIL'
+	exit 1
+fi
+if [ "$warned" -ne 0 ]; then
+	echo 'WARN'
+	exit 0
+fi
+echo 'PASS'
+exit 0
diff --git a/target/linux/ramips/mt76x8/base-files/etc/board.d/02_network b/target/linux/ramips/mt76x8/base-files/etc/board.d/02_network
index fbd21f5..1d15fad 100644
