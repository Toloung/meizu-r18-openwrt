+#!/bin/sh
+# First boot only. Keep a pre-existing theme choice during a settings-preserved
+# sysupgrade, but select Liquid for a clean install.
+
+[ "$(board_name)" = 'meizu,r18' ] || exit 0
+
+uci set system.@system[0].hostname='Meizu-R18'
+uci set luci.main.lang='zh_cn'
+if [ -z "$(uci -q get luci.main.mediaurlbase)" ]; then
+	uci set luci.main.mediaurlbase='/luci-static/liquid'
+fi
+uci commit system
+uci commit luci
+
+exit 0
