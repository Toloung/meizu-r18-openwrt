diff --git a/target/linux/ramips/dts/mt7628an_meizu_r18.dts b/target/linux/ramips/dts/mt7628an_meizu_r18.dts
new file mode 100644
index 0000000..de3eed3
--- /dev/null
+++ b/target/linux/ramips/dts/mt7628an_meizu_r18.dts
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/dts-v1/;
+
+#include "mt7628an.dtsi"
+
+/*
+ * Meizu R18 / Meizu Router Speed Edition
+ *
+ * Stage 2 board support is intentionally RAM-boot-first.  Do not infer GPIO
+ * polarity or assign Factory +0xe000 to Ethernet until this is verified on
+ * hardware; only calibration and MAC locations established by live evidence
+ * are used below.
+ */
+
+/ {
+	compatible = "meizu,r18", "mediatek,mt7628an-soc";
+	model = "Meizu R18";
+
+	chosen {
+		/* Confirmed Linux console setting; U-Boot baud remains unverified. */
+		bootargs = "console=ttyS0,57600";
+	};
+};
+
+&state_default {
+	gpio {
+		/* GPIO43 reset and GPIO4 power LED are deliberately not claimed here:
+		 * their electrical polarities are not yet verified. */
+		groups = "gpio", "p0led_an", "p1led_an", "p2led_an", "p3led_an",
+			 "p4led_an", "refclk", "wdt", "wled_an";
+		function = "gpio";
+	};
+};
+
+&spi0 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		/* TODO: the R18 maximum is unverified; retain a conservative test rate. */
+		spi-max-frequency = <12000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "bootloader";
+				reg = <0x000000 0x030000>;
+				read-only;
+			};
+
+			partition@30000 {
+				label = "config";
+				reg = <0x030000 0x010000>;
+				read-only;
+			};
+
+			partition@40000 {
+				label = "factory";
+				reg = <0x040000 0x010000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					eeprom_factory_0: eeprom@0 {
+						reg = <0x0000 0x0400>;
+					};
+
+					macaddr_factory_4: macaddr@4 {
+						reg = <0x0004 0x0006>;
+					};
+
+					macaddr_factory_28: macaddr@28 {
+						reg = <0x0028 0x0006>;
+					};
+
+					eeprom_factory_8000: eeprom@8000 {
+						reg = <0x8000 0x0200>;
+					};
+
+					macaddr_factory_8004: macaddr@8004 {
+						reg = <0x8004 0x0006>;
+					};
+				};
+			};
+
+			partition@50000 {
+				compatible = "denx,uimage";
+				label = "firmware";
+				reg = <0x050000 0xF00000>;
+			};
+
+			partition@f50000 {
+				label = "storage";
+				reg = <0xF50000 0x0B0000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&ethernet {
+	/* Factory +0x0028 is the live Padavan LAN MAC source. */
+	nvmem-cells = <&macaddr_factory_28>;
+	nvmem-cell-names = "mac-address";
+};
+
+&esw {
+	/* Driver-level physical topology. Network roles are set in 02_network. */
+	mediatek,portmap = <0x0a>;
+	/* P0 and P2 have no physical R18 connector; CPU is P6/eth0. */
+	mediatek,portdisable = <0x05>;
+};
+
+&wmac {
+	status = "okay";
+	nvmem-cells = <&eeprom_factory_0>, <&macaddr_factory_4>;
+	nvmem-cell-names = "eeprom", "mac-address";
+};
+
+&pcie {
+	status = "okay";
+};
+
+&pcie0 {
+	wifi@0,0 {
+		compatible = "mediatek,mt76";
+		reg = <0x0000 0 0 0 0>;
+		ieee80211-freq-limit = <5000000 6000000>;
+		nvmem-cells = <&eeprom_factory_8000>, <&macaddr_factory_8004>;
+		nvmem-cell-names = "eeprom", "mac-address";
+	};
+};
diff --git a/target/linux/ramips/mt76x8/base-files/etc/uci-defaults/99-r18-wifi-test b/target/linux/ramips/mt76x8/base-files/etc/uci-defaults/99-r18-wifi-test
new file mode 100644
index 0000000..c0ffee0
--- /dev/null
+++ b/target/linux/ramips/mt76x8/base-files/etc/uci-defaults/99-r18-wifi-test
@@ -0,0 +1,36 @@
+#!/bin/sh
+# First boot only. CI supplies the PSK in an image overlay; never store it in
+# the public board patch. The boot sequence runs wifi config before this.
+
+psk_file=/etc/r18-wifi-test-psk
+[ -r "$psk_file" ] || {
+	logger -t r18-wifi-test 'No private PSK supplied; leaving Wi-Fi disabled.'
+	exit 0
+}
+
+psk="$(cat "$psk_file")"
+rm -f "$psk_file"
+
+[ "${#psk}" -ge 8 ] || {
+	logger -t r18-wifi-test 'Invalid private PSK; leaving Wi-Fi disabled.'
+	exit 0
+}
+
+for radio in $(uci show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
+	[ "$(uci -q get "wireless.$radio.band")" = '2g' ] || continue
+
+	uci set "wireless.$radio.disabled=0"
+	uci -q delete wireless.r18_24g
+	uci set wireless.r18_24g='wifi-iface'
+	uci set wireless.r18_24g.device="$radio"
+	uci set wireless.r18_24g.mode='ap'
+	uci set wireless.r18_24g.network='lan'
+	uci set wireless.r18_24g.ssid='R18-OpenWrt-Test'
+	uci set wireless.r18_24g.encryption='psk2'
+	uci set wireless.r18_24g.key="$psk"
+done
+
+uci commit wireless
+uci set luci.main.lang='zh_cn'
+uci commit luci
+exit 0
diff --git a/target/linux/ramips/mt76x8/base-files/etc/init.d/r18-net-rescue b/target/linux/ramips/mt76x8/base-files/etc/init.d/r18-net-rescue
