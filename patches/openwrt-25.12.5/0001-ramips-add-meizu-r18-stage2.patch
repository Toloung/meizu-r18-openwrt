index 0000000..c0ffee1
--- /dev/null
+++ b/target/linux/ramips/mt76x8/base-files/etc/init.d/r18-net-rescue
@@ -0,0 +1,15 @@
+#!/bin/sh /etc/rc.common
+
+START=99
+USE_PROCD=1
+
+start_service() {
+	. /lib/functions/system.sh
+	[ "$(board_name)" = 'meizu,r18' ] || return 0
+
+	procd_open_instance
+	procd_set_param command /usr/sbin/r18-net-rescue-worker
+	procd_set_param stdout 0
+	procd_set_param stderr 0
+	procd_close_instance
+}
diff --git a/target/linux/ramips/mt76x8/base-files/usr/sbin/r18-net-rescue-worker b/target/linux/ramips/mt76x8/base-files/usr/sbin/r18-net-rescue-worker
new file mode 100755
index 0000000..c0ffee2
--- /dev/null
+++ b/target/linux/ramips/mt76x8/base-files/usr/sbin/r18-net-rescue-worker
@@ -0,0 +1,53 @@
+#!/bin/sh
+
+log=/root/r18-boot-debug.log
+
+run() {
+	echo "--- $*"
+	"$@" 2>&1 || true
+}
+
+before() {
+	echo '===== BEFORE RESCUE ====='
+	run date
+	run uptime
+	run cat /proc/mtd
+	run mount
+	run df -h
+	run ip link
+	run ip addr
+	run ip route
+	run uci show network
+	run uci show wireless
+	run ubus call system board
+	run ubus call network.interface.lan status
+	run ubus call network.interface.wan status
+	run wifi status
+	run swconfig dev switch0 show
+	run dmesg
+	run logread
+}
+
+after() {
+	echo '===== AFTER RESCUE ====='
+	run ip link
+	run ip addr
+	run ip route
+	run ubus call network.interface.lan status
+	run ubus call network.interface.wan status
+	run wifi status
+	run swconfig dev switch0 show
+}
+
+# Stage 2.3: let Clean Recovery boot normally before the one-shot fallback.
+sleep 180
+before > "$log"
+
+logger -t r18-net-rescue 'starting delayed network recovery'
+/etc/init.d/network restart
+sleep 10
+wifi reload
+sleep 10
+
+after >> "$log"
+logger -t r18-net-rescue 'delayed network recovery finished'
